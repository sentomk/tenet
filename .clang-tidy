# Tenet clang-tidy configuration.
# Adjust freely -- this is a starting point, not dogma.

Checks: >
  bugprone-*,
  modernize-*,
  performance-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers,
  -readability-identifier-length

WarningsAsErrors: ''
HeaderFilterRegex: 'include/tenet/.*'
